allow vendor_hal_perf_default hal_audio_default:dir { search open };
allow vendor_hal_perf_default hal_audio_default:file { open read };
allow vendor_hal_perf_default hal_fingerprint_default:file { open read };
allow vendor_hal_perf_default sysfs_thermal:file write;
# Perf scans the thermal configuration directory.
allow vendor_hal_perf_default vendor_thermal_data_file:dir r_dir_perms;
allow vendor_hal_perf_default vendor_shsusrd:dir search;
allow vendor_hal_perf_default vendor_shsusrd:file { open read };
allow vendor_hal_perf_default mediacodec:dir { search read };
allow vendor_hal_perf_default hal_camera_default:dir r_dir_perms;

# Read process identity for perf hint classification and process tracking.
allow vendor_hal_perf_default hal_camera_default:file { getattr open read };
allow vendor_hal_perf_default mediacodec:file { getattr open read };
allow vendor_hal_perf_default hal_graphics_composer_default:file getattr;
allow vendor_hal_perf_default vendor_hal_poweroptservice_qti:dir search;
allow vendor_hal_perf_default vendor_hal_poweroptservice_qti:file { getattr open read };
